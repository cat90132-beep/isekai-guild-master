[Unit]
Description=Isekai Guild Master TCP server
After=network.target

[Service]
Type=simple
User=guild
Group=guild
WorkingDirectory=/opt/guild-server
ExecStart=/usr/bin/python3 -B /opt/guild-server/server.py --host 0.0.0.0 --port 6677 --web-port 6767 --replay-dir /var/lib/guild-server/replays
StateDirectory=guild-server
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
